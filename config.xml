<?xml version='1.0' encoding='utf-8'?>
<widget id="fr.cours.enseirb" version="1.0.0" xmlns="http://www.w3.org/ns/widgets" xmlns:cdv="http://cordova.apache.org/ns/1.0">
    <name>ADE</name>
    <description>Application de visualisation planning ADE</description>
    <author email="dev@cordova.apache.org" href="https://cordova.apache.org">
        Apache Cordova Team
    </author>
    <content src="index.html" />
    <allow-intent href="http://*/*" />
    <allow-intent href="https://*/*" />
    <access origin="https://adeapp.bordeaux-inp.fr" />
    <allow-navigation href="https://adeapp.bordeaux-inp.fr/*" />
    <allow-intent href="https://adeapp.bordeaux-inp.fr/*" />

    <platform name="android">
        <preference name="AndroidWindowSplashScreenAnimatedIcon" value="resources/android/splash/drawable-port-xxxhdpi-screen.png" />
        <preference name="AndroidWindowSplashScreenBackground" value="#fff" />

        <!-- icones -->
        <icon src="resources/android/icon/drawable-xxxhdpi-icon.png" density="xxxhdpi"/>
        <icon src="resources/android/icon/drawable-xxhdpi-icon.png" density="xxhdpi"/>
        <icon src="resources/android/icon/drawable-xhdpi-icon.png" density="xhdpi"/>
        <icon src="resources/android/icon/drawable-hdpi-icon.png" density="hdpi"/>
        <icon src="resources/android/icon/drawable-mdpi-icon.png" density="mdpi"/>
    </platform>
</widget>

