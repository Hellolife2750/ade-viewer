{
  "name": "fr.cours.enseirb",
  "displayName": "Cours Enseirb",
  "version": "1.0.0",
  "description": "A sample Apache Cordova application that responds to the deviceready event.",
  "main": "index.js",
  "scripts": {
    "run android": "cordova run android --device",
    "debug android": "cordova build android --debug && adb install -r ./platforms/android/app/build/outputs/apk/debug/app-debug.apk",
    "proxy": "node dev-proxy/server.js",
    "browser": "cordova run browser",
    "dev": "concurrently \"npm run proxy\" \"npm run browser\"",
    "buil-icons": "cordova-res android --type icon --skip-config --copy",
    "build-container": "cd docker && docker build -t cordova-dev -f Dockerfile . && cd ..",
    "start-container": "docker run -it --rm --device /dev/bus/usb -v \"$(pwd):/app\" -v \"$(pwd)/.gradle-cache:/opt/gradle-8.7\" -p 8000:8000 cordova-dev bash -c 'cd /app && bash'",
    "build-release": "docker run --rm -it -v \"$(pwd):/app\" \"$(pwd)/.gradle-cache:/opt/gradle-8.7\" -e ALIAS_NAME='adeviewer' -e KEYSTORE_PASS='<passwd>' -e KEY_PASS='<passwd>' cordova-dev bash -c '/app/docker/build_release.sh'",
    "sass:watch": "sass --watch www/css/index.scss:www/css/index.css"
  },
  "keywords": [
    "ecosystem:cordova"
  ],
  "author": "Apache Cordova Team",
  "license": "Apache-2.0",
  "devDependencies": {
    "concurrently": "^9.2.1",
    "cordova-android": "^14.0.1",
    "cordova-browser": "^7.0.0",
    "cordova-plugin-advanced-http": "^3.3.1",
    "cordova-plugin-android-permissions": "^1.1.5",
    "cordova-plugin-background-fetch": "^7.2.4",
    "cordova-plugin-file": "^8.1.3",
    "cordova-plugin-nativestorage": "^2.3.2",
    "cordova-plugin-secure-storage": "^3.0.2",
    "cordova-plugin-x-toast": "^2.7.3",
    "phonegap-plugin-barcodescanner": "^8.1.0",
    "sass": "^1.93.2"
  },
  "cordova": {
    "platforms": [
      "browser",
      "android"
    ],
    "plugins": {
      "cordova-plugin-android-permissions": {},
      "cordova-plugin-advanced-http": {
        "ANDROIDBLACKLISTSECURESOCKETPROTOCOLS": "SSLv3,TLSv1"
      },
      "cordova-plugin-nativestorage": {},
      "phonegap-plugin-barcodescanner": {
        "ANDROID_SUPPORT_V4_VERSION": "27.+"
      },
      "cordova-plugin-file": {},
      "cordova-plugin-background-fetch": {},
      "cordova-plugin-splashscreen": {},
      "cordova-plugin-x-toast": {},
      "cordova-plugin-secure-storage": {}
    }
  },
  "dependencies": {
    "cors": "^2.8.5",
    "express": "^5.1.0",
    "http-proxy-middleware": "^3.0.5",
    "ical.js": "^2.2.1",
    "node-fetch": "^2.7.0"
  }
}